# Public datasets are downloaded locally, never committed.
data/raw/*
!data/raw/.gitkeep

# Generated experiment artifacts. Keep only compact, immutable summaries needed
# to inspect the reported results; raw runs, score shards, and checkpoints stay local.
results/*
!results/.gitkeep
!results/README.md
!results/main/
results/main/*
!results/main/data_audit.json
!results/main/manifest.json
!results/main/summary_metrics.csv
!results/main/bootstrap_deltas.csv
!results/main/atomic_summary.csv
!results/corpus_ordinal_reference/
results/corpus_ordinal_reference/*
!results/corpus_ordinal_reference/data_audit.json
!results/corpus_ordinal_reference/manifest.json
!results/corpus_ordinal_reference/summary_metrics.csv
!results/corpus_ordinal_reference/bootstrap_deltas.csv
!results/corpus_ordinal_reference/atomic_summary.csv
!results/qwen4b_paper_pool1000_full700/
results/qwen4b_paper_pool1000_full700/*
!results/qwen4b_paper_pool1000_full700/summary.json
!results/qwen4b_paper_pool1000_full700/per_query_metrics.csv
